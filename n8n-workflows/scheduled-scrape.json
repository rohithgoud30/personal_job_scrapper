{
  "name": "Scheduled Scrape",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtMinute": 5
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Hour at :05",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "workflowId": "={{ $workflow.id }}",
        "options": {}
      },
      "id": "run-orchestrator",
      "name": "Execute Scraper Orchestrator",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [470, 300],
      "notes": "Replace workflowId with the actual ID of the 'Scraper Orchestrator' workflow after import"
    }
  ],
  "connections": {
    "Every Hour at :05": {
      "main": [
        [{ "node": "Execute Scraper Orchestrator", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [{ "name": "scheduler" }, { "name": "job-scraper" }],
  "triggerCount": 1
}
